<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#2580DCC8">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="@color/player_selected" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="@color/player_accent" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/player_surface_raised" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="@color/player_border" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

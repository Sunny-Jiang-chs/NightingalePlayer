<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/player_accent</item>
        <item name="android:colorControlActivated">@color/player_accent</item>
        <item name="android:textColorPrimary">@color/player_text</item>
        <item name="android:textColorSecondary">@color/player_text_muted</item>
        <item name="android:alertDialogTheme">@style/PlayerDialogTheme</item>
        <item name="android:buttonStyle">@style/PlayerButton</item>
        <item name="android:editTextStyle">@style/PlayerEditText</item>
        <item name="android:popupMenuStyle">@style/PlayerPopupMenu</item>
        <item name="android:statusBarColor">#0D0F12</item>
        <item name="android:navigationBarColor">#0D0F12</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="PlayerPopupMenu" parent="android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/player_dialog_background</item>
        <item name="android:popupElevation">8dp</item>
    </style>
    <style name="PlayerDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/player_accent</item>
        <item name="android:colorControlActivated">@color/player_accent</item>
        <item name="android:colorBackground">@color/player_surface</item>
        <item name="android:textColorPrimary">@color/player_text</item>
        <item name="android:textColorSecondary">@color/player_text_muted</item>
        <item name="android:windowBackground">@drawable/player_dialog_background</item>
        <item name="android:buttonBarButtonStyle">@style/PlayerDialogAction</item>
        <item name="android:listPreferredItemHeightSmall">52dp</item>
    </style>
    <style name="PlayerButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/player_button_background</item>
        <item name="android:textColor">@color/player_button_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="PlayerDialogAction" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/player_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="PlayerEditText" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/player_button_background</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/player_text</item>
        <item name="android:textColorHint">@color/player_text_muted</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
